# Documentation only: set these in the shell or hosting control panel.
DATABASE_PATH=./data/alerta.db
# Optional PostgreSQL URL. Set this through hosting secrets, never in the repo.
# When nonempty, DATABASE_URL takes precedence over DATABASE_PATH.
DATABASE_URL=
COOKIE_SECURE=0
# HTTPS hosting: COOKIE_SECURE=1; use persistent storage for DATABASE_PATH.
# External messaging is disabled in the web application.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TEST_TO=
TWILIO_CONTENT_SID=
